# Local default: omit DATABASE_URL to use the SQLite file.
# Configure the Supabase Transaction Pooler URL only in the local shell or host.
# Keep the real password out of files and source control.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
VITE_API_URL=http://localhost:8000/api
FRONTEND_ORIGINS=http://localhost:5173
ORDER_MANAGEMENT_TOKEN=replace-with-a-long-random-secret
